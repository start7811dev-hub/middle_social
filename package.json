{
  "name": "middle-social",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && tsc -b && vite build",
    "preview": "vite preview",
    "validate": "node scripts/validate-content.mjs",
    "mac:dev": "npm run build && electron .",
    "mac:build": "npm run build && electron-builder --mac dmg zip --arm64 --x64"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^0.460.0",
    "pretendard": "^1.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "three": "^0.169.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.17.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "productName": "Social Atlas",
  "description": "중학 사회 3D 학습 프로그램",
  "author": "THE FROM",
  "main": "electron/main.cjs",
  "build": {
    "appId": "kr.thefrom.socialatlas",
    "productName": "Social Atlas",
    "copyright": "© THE FROM",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": false,
      "identity": "-"
    },
    "dmg": {
      "title": "Social Atlas",
      "background": null,
      "iconSize": 110,
      "contents": [
        {
          "x": 150,
          "y": 190
        },
        {
          "x": 420,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}