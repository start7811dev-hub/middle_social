# ── 쏘 서버 (Vercel 환경 변수 / 로컬은 .env.local) ──
ANTHROPIC_API_KEY=sk-ant-...           # 필수. 서버에만 둔다. 브라우저 코드에 넣지 말 것
# SSO_MODEL=claude-sonnet-5-5          # 본 응답 모델
# SSO_GUARD_MODEL=claude-haiku-5-5     # 주제 분류 모델
# SSO_ACCESS_CODE=class-2026           # 설정하면 이 코드를 입력한 기기만 사용
# SSO_ALLOWED_ORIGINS=https://my-domain.kr
# SSO_RATE_PER_10MIN=20

# ── 앱 빌드 옵션 ──
# VITE_SSO_SERVER=https://middle-social.vercel.app   # Mac 앱이 접속할 쏘 서버 (설정 화면에서도 입력 가능)
# VITE_CONTENT_SOURCES=./content,https://<호스트>/content-pack
