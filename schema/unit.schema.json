{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "unit.schema.json",
  "title": "Unit (대단원)",
  "type": "object",
  "required": [
    "id",
    "book",
    "area",
    "no",
    "title",
    "icon",
    "accent",
    "lessons"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^s[12]-[gs][0-9]{2}$"
    },
    "book": {
      "enum": [
        "s1",
        "s2"
      ]
    },
    "area": {
      "enum": [
        "지리",
        "일반사회"
      ]
    },
    "no": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "icon": {
      "type": "string"
    },
    "accent": {
      "enum": [
        "primary",
        "sky",
        "magenta",
        "orange",
        "green",
        "coral"
      ]
    },
    "impact3d": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "standardsVerified": {
      "type": "boolean"
    },
    "geo": {
      "type": "object",
      "required": [
        "lat",
        "lng"
      ],
      "additionalProperties": false,
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      }
    },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/lesson"
      }
    }
  },
  "definitions": {
    "lesson": {
      "type": "object",
      "required": [
        "id",
        "title",
        "standard",
        "concepts",
        "quiz"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "standard": {
          "type": "object",
          "required": [
            "code",
            "text",
            "verified"
          ],
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^9사\\((지리|일사)\\)[0-9]{2}-[0-9]{2}$"
            },
            "text": {
              "type": [
                "string",
                "null"
              ]
            },
            "verified": {
              "type": "boolean"
            }
          }
        },
        "lab": {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string"
            },
            "params": {
              "type": "object"
            }
          }
        },
        "media": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "src"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "image",
                  "video",
                  "model"
                ]
              },
              "src": {
                "type": "string"
              },
              "caption": {
                "type": "string"
              },
              "credit": {
                "type": "string"
              }
            }
          }
        },
        "concepts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "term",
              "desc"
            ],
            "additionalProperties": false,
            "properties": {
              "term": {
                "type": "string"
              },
              "desc": {
                "type": "string"
              }
            }
          }
        },
        "quiz": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "q",
              "choices",
              "answer",
              "explain"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "q": {
                "type": "string"
              },
              "choices": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string"
                }
              },
              "answer": {
                "type": "integer",
                "minimum": 0
              },
              "explain": {
                "type": "string"
              }
            }
          }
        },
        "predict": {
          "type": "object",
          "required": [
            "q",
            "choices",
            "answer",
            "reveal"
          ],
          "additionalProperties": false,
          "description": "랩을 보기 전에 묻는 예측 질문. 답을 고르면 랩이 열리고 reveal이 표시된다.",
          "properties": {
            "q": {
              "type": "string"
            },
            "choices": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string"
              }
            },
            "answer": {
              "type": "integer",
              "minimum": 0
            },
            "reveal": {
              "type": "string"
            }
          }
        },
        "mission": {
          "type": "string",
          "description": "현장 미션 — 생활 속에서 찾아 사진으로 남기는 과제"
        }
      }
    }
  }
}